# SpendWise AI – Environment Configuration Template

# Server Port (assigned automatically by Render, Railway, Heroku, etc.)
PORT=5001

# Application Environment ('production' | 'development')
NODE_ENV=production

# JWT Token Secret Key (provide a secure random string for production)
JWT_SECRET=spendwise_production_secret_key_change_in_production_2026

# Optional: Google OAuth 2.0 Client ID (from Google Cloud Console)
# If left empty, interactive authorization modal is active on frontend
GOOGLE_CLIENT_ID=

# Optional: Google Gemini API Key (from Google AI Studio)
# If left empty, SpendWise grounded financial deterministic intelligence is used automatically
GEMINI_API_KEY=

